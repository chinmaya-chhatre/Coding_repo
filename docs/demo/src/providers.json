    "contentType": "application/json",
    "secret": "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw",
    "signatureHeaders": [
      "svix-signature",
      "svix-id",
      "svix-timestamp"
    ],
